<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_note_title"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/note_input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/widget_note_hint"
        android:inputType="textCapSentences"
        android:maxLength="120"
        android:singleLine="true"
        android:textColor="@color/widget_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/note_input_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_input_cancel" />

        <Button
            android:id="@+id/note_input_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_input_save" />
    </LinearLayout>
</LinearLayout>
