<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_food_input_title"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/food_input_kcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/widget_food_kcal"
        android:inputType="number"
        android:maxLength="4"
        android:singleLine="true"
        android:textColor="@color/widget_text" />

    <EditText
        android:id="@+id/food_input_protein"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/widget_food_protein"
        android:inputType="number"
        android:maxLength="4"
        android:singleLine="true"
        android:textColor="@color/widget_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/food_input_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_input_cancel" />

        <Button
            android:id="@+id/food_input_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_input_save" />
    </LinearLayout>
</LinearLayout>
