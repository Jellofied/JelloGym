<?xml version="1.0" encoding="utf-8"?>
<!-- The Home Screen widget (JelloGymWidgetProvider): its colours in light mode (values-night has
     the dark ones), the words of the widget picker, and the configure screen's fallbacks. What a
     widget shows is in the app's language: the app writes those words with the data. -->
<resources>
    <color name="widget_bg">#FFFFFFFF</color>
    <color name="widget_text">#FF000000</color>
    <color name="widget_text_2">#993C3C43</color>
    <color name="widget_line">#1F3C3C43</color>
    <color name="widget_flame">#FFFF9500</color>
    <color name="widget_freeze">#FF32ADE6</color>

    <string name="widget_name">JelloGym</string>
    <string name="widget_desc">Your streak, weight goal, week, next workout, records or volume. You pick.</string>
    <string name="widget_what">What to show</string>
    <string name="widget_beside">And beside it (wide widget)</string>
    <string name="widget_done">Done</string>
    <string name="widget_kind_streak">Week streak</string>
    <string name="widget_kind_weight">Weight goal</string>
    <string name="widget_kind_week">This week</string>
    <string name="widget_kind_next">Next workout</string>
    <string name="widget_kind_records">Records</string>
    <string name="widget_kind_volume">Volume</string>
    <string name="widget_kind_challenges">Challenges</string>
    <string name="widget_empty">Open JelloGym once to fill this in.</string>
    <string name="widget_life_unsynced">Open JelloGym once to fill this in.</string>

    <!-- The Water widget (WaterWidgetProvider.java). Life modules are English only. -->
    <string name="widget_today">Today</string>
    <string name="widget_water_name">Water</string>
    <string name="widget_water_desc">Water for today in dots, with one-tap cups and a typed amount.</string>
    <string name="widget_water_off">Water is off in Settings.</string>
    <string name="widget_water_other">Other</string>
    <string name="widget_input_title">How much water?</string>
    <string name="widget_input_save">Save</string>
    <string name="widget_input_cancel">Cancel</string>

    <!-- Food, Habits and Note widgets (Android life modules, English only). -->
    <string name="widget_food_name">Food</string>
    <string name="widget_food_desc">Calories and protein for today in dots, with one-tap repeats.</string>
    <string name="widget_food_off">Food is off in Settings.</string>
    <string name="widget_food_other">Other</string>
    <string name="widget_food_input_title">What did you eat?</string>
    <string name="widget_food_kcal">Calories</string>
    <string name="widget_food_protein">Protein (g)</string>

    <string name="widget_habits_name">Habits</string>
    <string name="widget_habits_desc">Habits due today with a one-tap check.</string>
    <string name="widget_habits_off">Habits are off in Settings.</string>
    <string name="widget_habit_check">Check habit</string>

    <string name="widget_note_name">Note</string>
    <string name="widget_note_desc">A note for today, with one-tap tags and a typed note.</string>
    <string name="widget_note_empty">No note.</string>
    <string name="widget_note_tag_note">Note</string>
    <string name="widget_note_tag_idea">Idea</string>
    <string name="widget_note_tag_todo">To do</string>
    <string name="widget_note_tag_reminder">Reminder</string>
    <string name="widget_note_edit">Write</string>
    <string name="widget_note_title">Note</string>
    <string name="widget_note_hint">What do you want to remember?</string>

    <!-- Foreground service for the Nothing Glyph workout progress (sideload/play only). -->
    <string name="widget_glyph_channel">Workout Glyph</string>
    <string name="widget_glyph_title">Workout on Glyph</string>
    <string name="widget_glyph_text">Set progress shows on your Nothing Glyph.</string>

    <style name="WidgetConfigTheme" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
</resources>
