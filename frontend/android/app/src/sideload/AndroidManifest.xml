<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The in-app updater (InstallPlugin) hands the downloaded APK to the system installer.
         Only in this build: Google Play updates the Play build itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Nothing Glyph SDK: auto-granted permission and the SDK's debug key (Android 16 no longer
         restricts keys). F-Droid has neither this permission nor the SDK. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application>
        <meta-data android:name="NothingKey" android:value="test" />
    </application>
</manifest>
